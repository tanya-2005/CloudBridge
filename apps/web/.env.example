VITE_API_URL=http://localhost:4000/api

# In production, VITE_API_URL is overridden to a relative "/api" by
# .env.production, and the Railway Node service (server.js) proxies /api
# requests server-side to BACKEND_API_URL, so the browser only ever talks to
# the HTTPS Railway origin (avoids mixed-content blocking and CORS issues).
# BACKEND_API_URL is read at runtime by server.js and defaults to the backend
# deployed on Railway:
BACKEND_API_URL=https://130-210-50-67.nip.io
