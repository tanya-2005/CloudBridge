PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Google Drive (destination) — provide ONE of the two below.
# Not implementing OAuth yet: this is a service-account key, generated in
# Google Cloud Console, with the target Drive folder shared to its email.
# Leave both unset to run without Google Drive support.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","client_email":"...","private_key":"..."}
GOOGLE_DRIVE_ROOT_FOLDER_ID=root
