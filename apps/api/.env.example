PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (no trailing slashes).
# In development, any http(s)://localhost:*  or 127.0.0.1:* origin is also
# allowed automatically, regardless of what's listed here.
CORS_ORIGIN=http://localhost:5173,http://130.210.50.67:4173

# Google Drive (destination) — two independent auth paths, configure either
# or both. The frontend's Connect flow uses OAuth; the service account is
# an alternate/legacy path still supported by the backend.

# Option A: real OAuth (what the UI uses). Create an OAuth 2.0 Client ID
# ("Web application" type) in Google Cloud Console > APIs & Services >
# Credentials, and add GOOGLE_OAUTH_REDIRECT_URI to its Authorized redirect
# URIs exactly as written below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/connections/oauth/google/callback

# Option B: service account — a single shared server-side identity instead
# of per-user sign-in. Generated in Google Cloud Console; share the target
# Drive folder with the service account's email like you would a person.
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","client_email":"...","private_key":"..."}
GOOGLE_DRIVE_ROOT_FOLDER_ID=root
