VITE_API_URL=http://localhost:4000/api

# In production (Vercel), this is overridden by .env.production to a
# relative "/api" — vercel.json rewrites that to the Oracle backend
# server-side, so the browser only ever talks to the HTTPS Vercel origin
# (avoids mixed-content blocking and satisfies Google OAuth's HTTPS
# redirect-URI requirement without any TLS setup on the Oracle VM).
